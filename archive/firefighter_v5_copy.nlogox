<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[breed [firefighters firefighter]
breed [helicopters helicopter]
breed [villagers villager]

globals [initial-trees fire-size fire-sizes ff-cost heli-cost village-center initial-villagers]
patches-own [state elevation flammability]   ; tree fire ash empty water break village
firefighters-own [energy resting?]
helicopters-own [cooldown]

;; ================= SETUP =================
to setup
  clear-all
  set fire-sizes []
  set fire-size 0
  set ff-cost 1
  set heli-cost 10
  make-terrain
  ask patches [
    set flammability 1
    if pxcor > 15 [ set flammability 1.4 ]
    ifelse random-float 100 < density [ set state "tree" ] [ set state "empty" ]
    if abs (pycor - 10 * sin (pxcor * 6)) < 1.5 [ set state "water" ]
  ]
  make-village
  set initial-trees count patches with [state = "tree"]
  make-crews
  if initial-fire? [
    ask patches with [pxcor = min-pxcor and state = "tree"] [ set state "fire" ]
  ]
  recolor
  reset-ticks
end

to make-terrain
  ask n-of 6 patches [ set elevation 100 ]
  repeat 40 [ diffuse elevation 0.5 ]
  let top max [elevation] of patches
  ask patches [ set elevation 50 * elevation / top ]
end

to make-village
  set village-center patch -20 -20
  ask village-center [ ask patches in-radius 3 [ set state "village" ] ]
  create-villagers 20 [
    move-to village-center
    set heading random 360
    fd random-float 2.5
    set shape "person"
    set color yellow
  ]
  set initial-villagers count villagers
end

to make-crews
  let heli-n min list num-helicopters floor (budget / heli-cost)
  let ff-n num-firefighters
  create-firefighters ff-n [
    move-to one-of patches with [state = "village"]
    set shape "person"
    set color orange
    set energy 100
    set resting? false
  ]
  create-helicopters heli-n [
    move-to village-center
    set shape "airplane"
    set size 2
    set color white
    set cooldown 0
  ]
end

;; ================= MAIN LOOP =================
to go
  start-fires
  spread-fire
  ask firefighters [ firefighter-act ]
  ask helicopters [ helicopter-act ]
  ask villagers [ villager-act ]
  track-fires
  regrow
  recolor
  tick
end

to start-fires
  if random-float 100 < lightning-rate [
    let trees patches with [state = "tree"]
    if any? trees [ ask one-of trees [ set state "fire" ] ]
  ]
  if random-float 100 < camper-rate [
    let spots patches with [state = "tree" and distance village-center < 12]
    if any? spots [ ask one-of spots [ set state "fire" ] ]
  ]
end

to spread-fire
  ask patches with [state = "fire"] [
    ask neighbors with [state = "tree"] [
      let spread-dir ((towards myself) + 180) mod 360
      let diff abs (subtract-headings spread-dir wind-direction)
      let wind-factor max list 0 (1 + (wind-speed / 10) * cos diff)
      let slope-factor max list 0.2 (1 + 0.3 * (elevation - [elevation] of myself))
      let chance (1 - humidity / 100) * wind-factor * slope-factor * flammability
      if random-float 1 < chance [ set state "fire" ]
    ]
    set state "ash"
  ]
end

to regrow
  ask patches with [state = "ash" or state = "empty"] [
    if random-float 100 < regrowth-rate [ set state "tree" ]
  ]
  ask patches with [state = "break"] [
    if random-float 100 < 1 [ set state "empty" ]
  ]
end

;; ================= AGENTS =================
to firefighter-act
  if energy < 20 [ set resting? true ]
  if resting? [
    ifelse distance village-center > 2
      [ face village-center fd 1 ]
      [ set energy energy + 10 ]
    if energy >= 100 [ set resting? false ]
    stop
  ]
  let fires patches with [state = "fire"]
  if not any? fires [ stop ]
  let target min-one-of fires [distance myself]
  ifelse distance target > 3
    [ face target fd 1 ]
    [ ask patches in-radius 2 with [state = "tree"] [ set state "break" ]
      set energy energy - 2 ]
  set energy energy - 1
end

to helicopter-act
  if cooldown > 0 [ set cooldown cooldown - 1 stop ]
  let fires patches with [state = "fire"]
  if not any? fires [ stop ]
  let target max-one-of fires [count fires in-radius 3]
  ifelse distance target > 1
    [ face target fd min list 3 distance target ]
    [ ask patches in-radius 3 with [state = "fire"] [ set state "ash" ]
      set cooldown 5 ]
end

to villager-act
  let fires patches in-radius 6 with [state = "fire"]
  ifelse any? fires [
    face min-one-of fires [distance myself]
    rt 180
    if can-move? 1 [ fd 1 ]
  ] [
    ifelse [state] of patch-here = "village"
      [ rt random 60 lt random 60
        if [state] of patch-ahead 0.5 = "village" [ fd 0.2 ] ]
      [ face village-center fd 0.5 ]
  ]
  if any? patches in-radius 1 with [state = "fire"] [ die ]
end

;; ================= STATS =================
to track-fires
  let burning count patches with [state = "fire"]
  set fire-size fire-size + burning
  if burning = 0 and fire-size > 0 [
    set fire-sizes lput fire-size fire-sizes
    set fire-size 0
  ]
end

to-report burned-percent
  if initial-trees = 0 [ report 0 ]
  report 100 * count patches with [state = "ash"] / initial-trees
end

to-report tree-density
  let land count patches with [state != "water" and state != "village"]
  report 100 * count patches with [state = "tree"] / land
end

to-report biggest-fire
  ifelse empty? fire-sizes [ report 0 ] [ report max fire-sizes ]
end

to-report villagers-lost
  report initial-villagers - count villagers
end

to recolor
  ask patches [
    if state = "tree"    [ set pcolor scale-color green elevation -20 80 ]
    if state = "fire"    [ set pcolor red ]
    if state = "ash"     [ set pcolor gray - 2 ]
    if state = "empty"   [ set pcolor black ]
    if state = "water"   [ set pcolor blue ]
    if state = "break"   [ set pcolor sky ]
    if state = "village" [ set pcolor brown ]
  ]
end]]></code>
  <widgets>
    <view x="380" wrappingAllowedX="false" y="20" frameRate="30.0" minPycor="-30" height="595" showTickCounter="true" patchSize="9.7" fontSize="10" wrappingAllowedY="false" width="595" tickCounterLabel="ticks" maxPycor="30" updateMode="0" maxPxcor="30" minPxcor="-30"></view>
    <button x="30" y="25" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55">setup</button>
    <plot x="1170" autoPlotX="true" yMax="100.0" autoPlotY="true" yAxis="burned %" y="20" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="230" xAxis="time" display="Burned area">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update>plot burned-percent</update>
      </pen>
    </plot>
    <plot x="1170" autoPlotX="true" yMax="100.0" autoPlotY="true" yAxis="tree density (%)" y="205" xMin="0.0" height="175" legend="false" xMax="10.0" yMin="0.0" width="230" xAxis="time" display="Tree density">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update>plot tree-density</update>
      </pen>
    </plot>
    <plot x="1175" autoPlotX="false" yMax="20.0" autoPlotY="true" yAxis="number of fires" y="390" xMin="0.0" height="175" legend="false" xMax="5.0" yMin="0.0" width="230" xAxis="log10 of fire size" display="Fire size distribution">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="default" color="-16777216" legend="true">
        <setup></setup>
        <update><![CDATA[if not empty? fire-sizes [
  set-plot-pen-mode 1
  set-plot-pen-interval 0.25
  histogram map [ s -> log s 10 ] fire-sizes
]]]></update>
      </pen>
    </plot>
    <monitor x="1005" precision="1" y="30" height="60" fontSize="11" width="100" display="Burned %">burned-percent</monitor>
    <monitor x="1005" precision="17" y="110" height="60" fontSize="11" width="100" display="Tree density">tree-density</monitor>
    <monitor x="1005" precision="17" y="195" height="60" fontSize="11" width="100" display="Biggest fire">biggest-fire</monitor>
    <monitor x="1005" precision="17" y="280" height="60" fontSize="11" width="100" display="Villagers lost">villagers-lost</monitor>
    <monitor x="1005" precision="17" y="375" height="60" fontSize="11" width="100" display="Fires so far">length fire-sizes</monitor>
    <button x="110" y="25" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="55">go</button>
    <slider x="25" step="1" y="75" max="100" width="250" display="density" height="50" min="0" direction="Horizontal" default="46.0" variable="density"></slider>
    <slider x="25" step="1" y="575" max="100" width="250" display="budget" height="50" min="0" direction="Horizontal" default="100.0" variable="budget"></slider>
    <slider x="25" step="1" y="520" max="10" width="250" display="num-helicopters" height="50" min="0" direction="Horizontal" default="4.0" variable="num-helicopters"></slider>
    <slider x="25" step="1" y="465" max="50" width="250" display="num-firefighters" height="50" min="0" direction="Horizontal" default="3.0" variable="num-firefighters"></slider>
    <slider x="25" step="0.1" y="410" max="20" width="250" display="camper-rate" height="50" min="0" direction="Horizontal" default="2.2" variable="camper-rate"></slider>
    <slider x="25" step="0.1" y="355" max="20" width="250" display="lightning-rate" height="50" min="0" direction="Horizontal" default="0.0" variable="lightning-rate"></slider>
    <slider x="25" step="1" y="300" max="359" width="250" display="wind-direction" height="50" min="0" direction="Horizontal" default="90.0" variable="wind-direction"></slider>
    <slider x="25" step="0.01" y="245" max="1" width="250" display="regrowth-rate" height="50" min="0" direction="Horizontal" default="0.0" variable="regrowth-rate"></slider>
    <slider x="25" step="1" y="190" max="100" width="250" display="humidity" height="50" min="0" direction="Horizontal" default="0.0" variable="humidity"></slider>
    <slider x="25" step="1" y="130" max="20" width="250" display="wind-speed" height="50" min="0" direction="Horizontal" default="10.0" variable="wind-speed"></slider>
    <switch x="195" y="20" height="40" on="false" variable="initial-fire?" width="90" display="initial-fire?"></switch>
  </widgets>
